<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvTituloBanco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Datos Bancarios"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvBancoNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Institución: Banco Estado"
            android:textSize="16sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvTipoCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de cuenta: Cuenta Vista / Rut"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvNumeroCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="N° de Cuenta: 123456789"
            android:textSize="14sp"
            android:textColor="#666666" />
    </LinearLayout>

</LinearLayout>